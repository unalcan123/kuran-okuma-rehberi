  "data": [
    {
      "id": "6231",
      "sura": "114",
      "aya": "1",
      "arabic_text": "قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
      "translation": "Zeg: “Ik neem mijn toevlucht tot de Heer der mensheid.\"",
      "footnotes": ""
    },
    {
      "id": "6232",
      "sura": "114",
      "aya": "2",
      "arabic_text": "مَلِكِ ٱلنَّاسِ",
      "translation": "De Koning der mensheid.",
      "footnotes": ""
    },
    {
      "id": "6233",
      "sura": "114",
      "aya": "3",
      "arabic_text": "إِلَٰهِ ٱلنَّاسِ",
      "translation": "De Heer der mensheid.",
      "footnotes": ""
    },
    {
      "id": "6234",
      "sura": "114",
      "aya": "4",
      "arabic_text": "مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ",
      "translation": "Tegen het kwaad van de rondsluipende fluisteraar (Shaytaan, maar deze trekt zich terug zodra Allah wordt herdacht).",
      "footnotes": ""
    },
    {
      "id": "6235",
      "sura": "114",
      "aya": "5",
      "arabic_text": "ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ",
      "translation": "Die in de harten van de mensheid fluistert.",
      "footnotes": ""
    },
    {
      "id": "6236",
      "sura": "114",
      "aya": "6",
      "arabic_text": "مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ",
      "translation": "Zowel djinn als mensen.",
      "footnotes": ""
    }
  ],
