{
  "url": "https://quranenc.com/en/browse/french_rashid/113",
  "data": [
    {
      "id": "6226",
      "sura": "113",
      "aya": "1",
      "arabic_text": "قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ",
      "translation": "Dis : « J’implore la protection du Seigneur de l’aube,",
      "footnotes": ""
    },
    {
      "id": "6227",
      "sura": "113",
      "aya": "2",
      "arabic_text": "مِن شَرِّ مَا خَلَقَ",
      "translation": "contre le mal qui se trouve dans ce qu’Il a créé,",
      "footnotes": ""
    },
    {
      "id": "6228",
      "sura": "113",
      "aya": "3",
      "arabic_text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "translation": "contre le mal de la nuit qui étend son obscurité,",
      "footnotes": ""
    },
    {
      "id": "6229",
      "sura": "113",
      "aya": "4",
      "arabic_text": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ",
      "translation": "contre le charme maléfique de tous les sorciers[1],",
      "footnotes": "[1] Littéralement : contre le mal des sorcières qui soufflent dans les nœuds."
    },
    {
      "id": "6230",
      "sura": "113",
      "aya": "5",
      "arabic_text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "translation": "contre l’envieux qui donne libre cours à sa méchanceté. »",
      "footnotes": ""
    }
  ],
