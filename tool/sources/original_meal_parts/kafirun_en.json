  "data": [
    {
      "id": "6208",
      "sura": "109",
      "aya": "1",
      "arabic_text": "قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ",
      "translation": "Say, \"O disbelievers,",
      "footnotes": ""
    },
    {
      "id": "6209",
      "sura": "109",
      "aya": "2",
      "arabic_text": "لَآ أَعۡبُدُ مَا تَعۡبُدُونَ",
      "translation": "I do not worship what you worship.",
      "footnotes": ""
    },
    {
      "id": "6210",
      "sura": "109",
      "aya": "3",
      "arabic_text": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ",
      "translation": "Nor are you worshippers of what I worship.",
      "footnotes": ""
    },
    {
      "id": "6211",
      "sura": "109",
      "aya": "4",
      "arabic_text": "وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ",
      "translation": "Nor will I be a worshipper of what you worship.",
      "footnotes": ""
    },
    {
      "id": "6212",
      "sura": "109",
      "aya": "5",
      "arabic_text": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ",
      "translation": "Nor will you be worshippers of what I worship.",
      "footnotes": ""
    },
    {
      "id": "6213",
      "sura": "109",
      "aya": "6",
      "arabic_text": "لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ",
      "translation": "For you is your religion, and for me is my religion.\"",
      "footnotes": ""
    }
  ],
