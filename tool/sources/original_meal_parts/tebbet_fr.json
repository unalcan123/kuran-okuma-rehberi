{
  "url": "https://quranenc.com/en/browse/french_rashid/111",
  "data": [
    {
      "id": "6217",
      "sura": "111",
      "aya": "1",
      "arabic_text": "تَبَّتۡ يَدَآ أَبِي لَهَبٖ وَتَبَّ",
      "translation": "Que soit perdu Abou Lahab ! Et il est bel et bien perdu.",
      "footnotes": ""
    },
    {
      "id": "6218",
      "sura": "111",
      "aya": "2",
      "arabic_text": "مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ",
      "translation": "Ses richesses et ses œuvres ne lui seront d’aucune utilité.",
      "footnotes": ""
    },
    {
      "id": "6219",
      "sura": "111",
      "aya": "3",
      "arabic_text": "سَيَصۡلَىٰ نَارٗا ذَاتَ لَهَبٖ",
      "translation": "Il brûlera dans un feu aux flammes à jamais attisées,",
      "footnotes": ""
    },
    {
      "id": "6220",
      "sura": "111",
      "aya": "4",
      "arabic_text": "وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ",
      "translation": "de même que sa femme qui, de ronces, chargée[1],",
      "footnotes": "[1] Ronces qu’elle jetait sur la route empruntée par le Messager."
    },
    {
      "id": "6221",
      "sura": "111",
      "aya": "5",
      "arabic_text": "فِي جِيدِهَا حَبۡلٞ مِّن مَّسَدِۭ",
      "translation": "porte autour du cou une corde de fibres tressées.",
      "footnotes": ""
    }
  ],
