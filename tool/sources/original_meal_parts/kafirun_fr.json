{
  "url": "https://quranenc.com/en/browse/french_rashid/109",
  "data": [
    {
      "id": "6208",
      "sura": "109",
      "aya": "1",
      "arabic_text": "قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ",
      "translation": "Dis : « Vous mécréants qui avez rejeté la foi !",
      "footnotes": ""
    },
    {
      "id": "6209",
      "sura": "109",
      "aya": "2",
      "arabic_text": "لَآ أَعۡبُدُ مَا تَعۡبُدُونَ",
      "translation": "Je n’adore pas les dieux que vous adorez,",
      "footnotes": ""
    },
    {
      "id": "6210",
      "sura": "109",
      "aya": "3",
      "arabic_text": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ",
      "translation": "et vous n’adorez pas le Dieu que j’adore.",
      "footnotes": ""
    },
    {
      "id": "6211",
      "sura": "109",
      "aya": "4",
      "arabic_text": "وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ",
      "translation": "Je ne vénérerai jamais vos fausses divinités,",
      "footnotes": ""
    },
    {
      "id": "6212",
      "sura": "109",
      "aya": "5",
      "arabic_text": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ",
      "translation": "et vous ne vénérerez jamais mon Seigneur.",
      "footnotes": ""
    },
    {
      "id": "6213",
      "sura": "109",
      "aya": "6",
      "arabic_text": "لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ",
      "translation": "Vous suivez votre culte et moi le mien. »",
      "footnotes": ""
    }
  ],
