  "data": [
    {
      "id": "6205",
      "sura": "108",
      "aya": "1",
      "arabic_text": "إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ",
      "translation": "Nous t’avons, en vérité, accordé d’immenses faveurs[1].",
      "footnotes": "[1] En particulier un fleuve du Paradis appelé Al-Kawthar."
    },
    {
      "id": "6206",
      "sura": "108",
      "aya": "2",
      "arabic_text": "فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ",
      "translation": "Accomplis donc la prière et le sacrifice pour ton Seigneur !",
      "footnotes": ""
    },
    {
      "id": "6207",
      "sura": "108",
      "aya": "3",
      "arabic_text": "إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ",
      "translation": "C’est celui qui te voue de la haine qui sera sans postérité[2].",
      "footnotes": "[2] Et ne connaîtra aucun bien."
    }
  ],
