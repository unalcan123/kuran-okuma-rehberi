  "data": [
    {
      "id": "6217",
      "sura": "111",
      "aya": "1",
      "arabic_text": "تَبَّتۡ يَدَآ أَبِي لَهَبٖ وَتَبَّ",
      "translation": "Vervloekt zijn de twee handen van Aboe Lahab en vervloekt is hij!",
      "footnotes": ""
    },
    {
      "id": "6218",
      "sura": "111",
      "aya": "2",
      "arabic_text": "مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ",
      "translation": "Hij zal geen nut hebben van zijn weelde en zijn kinderen!",
      "footnotes": ""
    },
    {
      "id": "6219",
      "sura": "111",
      "aya": "3",
      "arabic_text": "سَيَصۡلَىٰ نَارٗا ذَاتَ لَهَبٖ",
      "translation": "Hij zal in een vuur branden met laaiende vlammen!",
      "footnotes": ""
    },
    {
      "id": "6220",
      "sura": "111",
      "aya": "4",
      "arabic_text": "وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ",
      "translation": "En ook zijn vrouw, die het hout draagt.",
      "footnotes": ""
    },
    {
      "id": "6221",
      "sura": "111",
      "aya": "5",
      "arabic_text": "فِي جِيدِهَا حَبۡلٞ مِّن مَّسَدِۭ",
      "translation": "Om haar nek is een touw van palmvezels gebonden.",
      "footnotes": ""
    }
  ],
  "language": "nl",
