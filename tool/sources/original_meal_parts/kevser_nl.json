    {
      "id": "6205",
      "sura": "108",
      "aya": "1",
      "arabic_text": "إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ",
      "translation": "Waarlijk, Wij hebben jou (o Mohammed vrede zij met hem) Al-Kawther geschonken.",
      "footnotes": ""
    },
    {
      "id": "6206",
      "sura": "108",
      "aya": "2",
      "arabic_text": "فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ",
      "translation": "Bid daarom tot jouw Heer en offer (voor Hem alleen).",
      "footnotes": ""
    },
    {
      "id": "6207",
      "sura": "108",
      "aya": "3",
      "arabic_text": "إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ",
      "translation": "Want jouw vijand, degene die jou bespot, zal afgesneden worden.",
      "footnotes": ""
    }
  ],
