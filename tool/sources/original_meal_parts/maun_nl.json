{
  "url": "https://quranenc.com/en/browse/dutch_center/107",
  "data": [
    {
      "id": "6198",
      "sura": "107",
      "aya": "1",
      "arabic_text": "أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ",
      "translation": "Heb je degenen gezien die de afrekening ontkent?",
      "footnotes": ""
    },
    {
      "id": "6199",
      "sura": "107",
      "aya": "2",
      "arabic_text": "فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ",
      "translation": "Dat is degenen die (meedogenloos) de wees afstoot.",
      "footnotes": ""
    },
    {
      "id": "6200",
      "sura": "107",
      "aya": "3",
      "arabic_text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ",
      "translation": "En niet (zichzelf noch anderen) aanspoort tot het voeden van de armen.",
      "footnotes": ""
    },
    {
      "id": "6201",
      "sura": "107",
      "aya": "4",
      "arabic_text": "فَوَيۡلٞ لِّلۡمُصَلِّينَ",
      "translation": "O wee, voor diegenen die (onachtzaam) in hun gebeden.",
      "footnotes": ""
    },
    {
      "id": "6202",
      "sura": "107",
      "aya": "5",
      "arabic_text": "ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ",
      "translation": "Die hun gebeden uitstellen van hun bepaalde tijd.",
      "footnotes": ""
    },
    {
      "id": "6203",
      "sura": "107",
      "aya": "6",
      "arabic_text": "ٱلَّذِينَ هُمۡ يُرَآءُونَ",
      "translation": "Degenen die slechts goed doen om gezien te worden (in gebed e.a.).",
      "footnotes": ""
    },
    {
      "id": "6204",
      "sura": "107",
      "aya": "7",
      "arabic_text": "وَيَمۡنَعُونَ ٱلۡمَاعُونَ",
      "translation": "En de levensnoodzakelijke benodigdheden weigeren.",
      "footnotes": ""
    }
  ],
