  "data": [
    {
      "id": "6214",
      "sura": "110",
      "aya": "1",
      "arabic_text": "إِذَا جَآءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ",
      "translation": "Lorsque, t’apportant Son secours, Allah te fera triompher[1]",
      "footnotes": "[1] De tes ennemis, par la conquête de la Mecque."
    },
    {
      "id": "6215",
      "sura": "110",
      "aya": "2",
      "arabic_text": "وَرَأَيۡتَ ٱلنَّاسَ يَدۡخُلُونَ فِي دِينِ ٱللَّهِ أَفۡوَاجٗا",
      "translation": "et que tu verras les hommes embrasser la religion d’Allah par groupes entiers,",
      "footnotes": ""
    },
    {
      "id": "6216",
      "sura": "110",
      "aya": "3",
      "arabic_text": "فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَٱسۡتَغۡفِرۡهُۚ إِنَّهُۥ كَانَ تَوَّابَۢا",
      "translation": "célèbre, par les louanges, la gloire de ton Seigneur et implore Son pardon. Il accepte toujours le repentir de Ses serviteurs dévoués.",
      "footnotes": ""
    }
  ],
