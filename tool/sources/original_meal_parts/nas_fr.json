{
  "url": "https://quranenc.com/en/browse/french_rashid/114",
  "data": [
    {
      "id": "6231",
      "sura": "114",
      "aya": "1",
      "arabic_text": "قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
      "translation": "Dis : « J’implore la protection du Seigneur des hommes,",
      "footnotes": ""
    },
    {
      "id": "6232",
      "sura": "114",
      "aya": "2",
      "arabic_text": "مَلِكِ ٱلنَّاسِ",
      "translation": "Maître des hommes,",
      "footnotes": ""
    },
    {
      "id": "6233",
      "sura": "114",
      "aya": "3",
      "arabic_text": "إِلَٰهِ ٱلنَّاسِ",
      "translation": "Dieu des hommes,",
      "footnotes": ""
    },
    {
      "id": "6234",
      "sura": "114",
      "aya": "4",
      "arabic_text": "مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ",
      "translation": "contre le mal du démon qui se dérobe[1] ou s’insinue chez l’homme[2],",
      "footnotes": "[1] Lorsque l’homme se souvient de son Seigneur et invoque Son nom.\n[2] Lorsque l’homme se montre insouciant et oublie son Seigneur."
    },
    {
      "id": "6235",
      "sura": "114",
      "aya": "5",
      "arabic_text": "ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ",
      "translation": "soufflant d’insidieuses pensées dans le cœur des hommes,",
      "footnotes": ""
    },
    {
      "id": "6236",
      "sura": "114",
      "aya": "6",
      "arabic_text": "مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ",
      "translation": "qu’il soit du nombre des djinns ou du nombre des hommes. »",
      "footnotes": ""
    }
  ],
