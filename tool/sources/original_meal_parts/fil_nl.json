  "data": [
    {
      "id": "6189",
      "sura": "105",
      "aya": "1",
      "arabic_text": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ",
      "translation": "Heb jij (o Mohammed) hoe jouw Heer de metgezellen van de olifanten behandelde?",
      "footnotes": ""
    },
    {
      "id": "6190",
      "sura": "105",
      "aya": "2",
      "arabic_text": "أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ",
      "translation": "Heeft Hij hun plan (om de Ka’bah te vernietigen) dan niet tot een dwaalspoor gebracht.",
      "footnotes": ""
    },
    {
      "id": "6191",
      "sura": "105",
      "aya": "3",
      "arabic_text": "وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ",
      "translation": "Door zwermen vogels naar hen toe te sturen.",
      "footnotes": ""
    },
    {
      "id": "6192",
      "sura": "105",
      "aya": "4",
      "arabic_text": "تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ",
      "translation": "Die hen met brandende stenen troffen.",
      "footnotes": ""
    },
    {
      "id": "6193",
      "sura": "105",
      "aya": "5",
      "arabic_text": "فَجَعَلَهُمۡ كَعَصۡفٖ مَّأۡكُولِۭ",
      "translation": "En hij maakte hen als opgegeten graan.",
      "footnotes": ""
    }
  ],
  "language": "nl",
