  "data": [
    {
      "id": "6194",
      "sura": "106",
      "aya": "1",
      "arabic_text": "لِإِيلَٰفِ قُرَيۡشٍ",
      "translation": "Que les Qouraych manifestent leur gratitude pour leur unité",
      "footnotes": ""
    },
    {
      "id": "6195",
      "sura": "106",
      "aya": "2",
      "arabic_text": "إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ",
      "translation": "et leur habitude d’effectuer des voyages en hiver et en été[1],",
      "footnotes": "[1] Des voyages commerciaux effectués l’hiver vers le Yémen et l’été vers la Grande Syrie. Rappelons que la tribu mecquoise de Qouraych vivait essentiellement du négoce qui constituait donc pour elle une immense grâce."
    },
    {
      "id": "6196",
      "sura": "106",
      "aya": "3",
      "arabic_text": "فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ",
      "translation": "en vouant un culte exclusif au Seigneur de cette Demeure",
      "footnotes": ""
    },
    {
      "id": "6197",
      "sura": "106",
      "aya": "4",
      "arabic_text": "ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ",
      "translation": "par la grâce duquel ils ne connaissent ni la faim, ni la peur[2].",
      "footnotes": "[2] Le négoce mettait les Qouraychites à l’abri de la faim et leur unité à l’abri de la peur de l’ennemi."
    }
  ],
