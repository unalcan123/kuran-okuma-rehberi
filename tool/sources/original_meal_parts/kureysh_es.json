  "data": [
    {
      "id": "6194",
      "sura": "106",
      "aya": "1",
      "arabic_text": "لِإِيلَٰفِ قُرَيۡشٍ",
      "translation": "1. Le proporcioné seguridad a [la tribu de] Quraish,",
      "footnotes": ""
    },
    {
      "id": "6195",
      "sura": "106",
      "aya": "2",
      "arabic_text": "إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ",
      "translation": "2. e hice que sus caravanas en invierno [al Yemen] y en verano [a Siria] fueran respetadas.",
      "footnotes": ""
    },
    {
      "id": "6196",
      "sura": "106",
      "aya": "3",
      "arabic_text": "فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ",
      "translation": "3. Que adoren y agradezcan, en consecuencia, al Señor de esta Casa [la Ka‘bah],",
      "footnotes": ""
    },
    {
      "id": "6197",
      "sura": "106",
      "aya": "4",
      "arabic_text": "ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ",
      "translation": "4. Quien les concedió el sustento para que no sufrieran hambre y les dio seguridad para protegerlos del peligro.",
      "footnotes": ""
    }
  ],
