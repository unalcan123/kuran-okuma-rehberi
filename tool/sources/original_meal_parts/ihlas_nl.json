  "data": [
    {
      "id": "6222",
      "sura": "112",
      "aya": "1",
      "arabic_text": "قُلۡ هُوَ ٱللَّهُ أَحَدٌ",
      "translation": "Zeg: “Hij is Allah, de Enige (zo zou Allah de Enige moeten zijn in onze harten).\"",
      "footnotes": ""
    },
    {
      "id": "6223",
      "sura": "112",
      "aya": "2",
      "arabic_text": "ٱللَّهُ ٱلصَّمَدُ",
      "translation": "Allah de Eeuwige, de Onafhankelijke (waarvan alles en iedereen afhankelijk is).",
      "footnotes": ""
    },
    {
      "id": "6224",
      "sura": "112",
      "aya": "3",
      "arabic_text": "لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ",
      "translation": "Hij heeft niet verwerkt, noch is Hij verwekt.",
      "footnotes": ""
    },
    {
      "id": "6225",
      "sura": "112",
      "aya": "4",
      "arabic_text": "وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ",
      "translation": "En er is niets of niemand die met Hem te vergelijken is, (in welk opzicht dan ook).” [1]",
      "footnotes": "[1] Als het gaat om de loyaliteit aan Allah, dan is er een duidelijk verschil tussen de waarheid en onwetendheid, en tussen de Islam en onwetendheid."
    }
  ],
