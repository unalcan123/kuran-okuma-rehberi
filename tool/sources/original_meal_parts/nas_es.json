  "data": [
    {
      "id": "6231",
      "sura": "114",
      "aya": "1",
      "arabic_text": "قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
      "translation": "1. Di: “Me refugio en el Señor de los seres humanos,",
      "footnotes": ""
    },
    {
      "id": "6232",
      "sura": "114",
      "aya": "2",
      "arabic_text": "مَلِكِ ٱلنَّاسِ",
      "translation": "2. en el Rey Soberano de los seres humanos,",
      "footnotes": ""
    },
    {
      "id": "6233",
      "sura": "114",
      "aya": "3",
      "arabic_text": "إِلَٰهِ ٱلنَّاسِ",
      "translation": "3. en el [único] Dios de los seres humanos,",
      "footnotes": ""
    },
    {
      "id": "6234",
      "sura": "114",
      "aya": "4",
      "arabic_text": "مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ",
      "translation": "4. de la maldad del [demonio] susurrador que huye [cuando el nombre de Dios es mencionado],",
      "footnotes": ""
    },
    {
      "id": "6235",
      "sura": "114",
      "aya": "5",
      "arabic_text": "ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ",
      "translation": "5. que susurra en los corazones de los seres humanos,",
      "footnotes": ""
    },
    {
      "id": "6236",
      "sura": "114",
      "aya": "6",
      "arabic_text": "مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ",
      "translation": "6. y existe entre los yinn y entre los seres humanos”.",
      "footnotes": ""
    }
  ],
