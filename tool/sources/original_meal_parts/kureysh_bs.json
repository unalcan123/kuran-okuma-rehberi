      "id": "6194",
      "sura": "106",
      "aya": "1",
      "arabic_text": "لِإِيلَٰفِ قُرَيۡشٍ",
      "translation": "Zbog udruživanja: Kurejšija, ",
      "footnotes": ""
    },
    {
      "id": "6195",
      "sura": "106",
      "aya": "2",
      "arabic_text": "إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ",
      "translation": "udruživanja njihova da zimi i ljeti putuju, ",
      "footnotes": ""
    },
    {
      "id": "6196",
      "sura": "106",
      "aya": "3",
      "arabic_text": "فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ",
      "translation": "neka oni Gospodaru ove Kuće ibadet čine, ",
      "footnotes": ""
    },
    {
      "id": "6197",
      "sura": "106",
      "aya": "4",
      "arabic_text": "ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ",
      "translation": "Koji ih gladne hrani i od straha brani. ",
      "footnotes": ""
    }
  ],
