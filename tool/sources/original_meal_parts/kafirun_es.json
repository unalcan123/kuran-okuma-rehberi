  "data": [
    {
      "id": "6208",
      "sura": "109",
      "aya": "1",
      "arabic_text": "قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ",
      "translation": "1. Di: “¡Oh, incrédulos!",
      "footnotes": ""
    },
    {
      "id": "6209",
      "sura": "109",
      "aya": "2",
      "arabic_text": "لَآ أَعۡبُدُ مَا تَعۡبُدُونَ",
      "translation": "2. No adoro lo que adoran.",
      "footnotes": ""
    },
    {
      "id": "6210",
      "sura": "109",
      "aya": "3",
      "arabic_text": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ",
      "translation": "3. Ni adoran ustedes a Quien yo adoro.",
      "footnotes": ""
    },
    {
      "id": "6211",
      "sura": "109",
      "aya": "4",
      "arabic_text": "وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ",
      "translation": "4. Y jamás adoraré lo que adoran.",
      "footnotes": ""
    },
    {
      "id": "6212",
      "sura": "109",
      "aya": "5",
      "arabic_text": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ",
      "translation": "5. Ni adorarán ustedes a Quien yo adoro.",
      "footnotes": ""
    },
    {
      "id": "6213",
      "sura": "109",
      "aya": "6",
      "arabic_text": "لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ",
      "translation": "6. Ustedes tienen su religión y yo la mía”.",
      "footnotes": ""
    }
  ],
