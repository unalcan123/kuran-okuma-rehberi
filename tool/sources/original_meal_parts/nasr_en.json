  "data": [
    {
      "id": "6214",
      "sura": "110",
      "aya": "1",
      "arabic_text": "إِذَا جَآءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ",
      "translation": "When the victory of Allāh has come and the conquest,[2005]",
      "footnotes": "[2005] The conquest of Makkah."
    },
    {
      "id": "6215",
      "sura": "110",
      "aya": "2",
      "arabic_text": "وَرَأَيۡتَ ٱلنَّاسَ يَدۡخُلُونَ فِي دِينِ ٱللَّهِ أَفۡوَاجٗا",
      "translation": "And you see the people entering into the religion of Allāh in multitudes,",
      "footnotes": ""
    },
    {
      "id": "6216",
      "sura": "110",
      "aya": "3",
      "arabic_text": "فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَٱسۡتَغۡفِرۡهُۚ إِنَّهُۥ كَانَ تَوَّابَۢا",
      "translation": "Then exalt [Him] with praise of your Lord and ask forgiveness of Him. Indeed, He is ever Accepting of Repentance.[2006]",
      "footnotes": "[2006] Refer to footnote of 2:37."
    }
  ],
