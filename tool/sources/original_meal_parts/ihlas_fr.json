  "data": [
    {
      "id": "6222",
      "sura": "112",
      "aya": "1",
      "arabic_text": "قُلۡ هُوَ ٱللَّهُ أَحَدٌ",
      "translation": "Dis : « Allah est la seule et unique divinité.",
      "footnotes": ""
    },
    {
      "id": "6223",
      "sura": "112",
      "aya": "2",
      "arabic_text": "ٱللَّهُ ٱلصَّمَدُ",
      "translation": "Allah est le Maître dont nul ne peut se passer[1].",
      "footnotes": "[1] Celui vers lequel se tournent toutes les créatures afin qu’Il réponde à leurs besoins."
    },
    {
      "id": "6224",
      "sura": "112",
      "aya": "3",
      "arabic_text": "لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ",
      "translation": "Il n’a pas engendré, ni été Lui-même engendré.",
      "footnotes": ""
    },
    {
      "id": "6225",
      "sura": "112",
      "aya": "4",
      "arabic_text": "وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ",
      "translation": "Et nul dans Sa création n’est à même de L’égaler. »",
      "footnotes": ""
    }
  ],
