  "data": [
    {
      "id": "6208",
      "sura": "109",
      "aya": "1",
      "arabic_text": "قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ",
      "translation": "Zeg: “O ongelovigen!”",
      "footnotes": ""
    },
    {
      "id": "6209",
      "sura": "109",
      "aya": "2",
      "arabic_text": "لَآ أَعۡبُدُ مَا تَعۡبُدُونَ",
      "translation": "Ik aanbid niet wat jullie aanbidden.",
      "footnotes": ""
    },
    {
      "id": "6210",
      "sura": "109",
      "aya": "3",
      "arabic_text": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ",
      "translation": "Noch zullen jullie aanbidden wat ik aanbid.",
      "footnotes": ""
    },
    {
      "id": "6211",
      "sura": "109",
      "aya": "4",
      "arabic_text": "وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ",
      "translation": "En ik zal niet aanbidden wat jullie aanbidden.",
      "footnotes": ""
    },
    {
      "id": "6212",
      "sura": "109",
      "aya": "5",
      "arabic_text": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ",
      "translation": "Noch zullen jullie aanbidden wat ik aanbid (alleen als jullie overgaven hebben).",
      "footnotes": ""
    },
    {
      "id": "6213",
      "sura": "109",
      "aya": "6",
      "arabic_text": "لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ",
      "translation": "Daarom voor jullie jullie godsdienst en voor mij de mijne (het Islamitisch monotheïsme).",
      "footnotes": ""
    }
  ],
