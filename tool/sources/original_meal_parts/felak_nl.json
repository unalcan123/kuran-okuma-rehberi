{
  "url": "https://quranenc.com/en/browse/dutch_center/113",
  "data": [
    {
      "id": "6226",
      "sura": "113",
      "aya": "1",
      "arabic_text": "قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ",
      "translation": "Zeg: “Ik neem mijn toevlucht tot de Heer van de dageraad.\"",
      "footnotes": ""
    },
    {
      "id": "6227",
      "sura": "113",
      "aya": "2",
      "arabic_text": "مِن شَرِّ مَا خَلَقَ",
      "translation": "Tegen het kwaad wat Hij heeft geschapen.",
      "footnotes": ""
    },
    {
      "id": "6228",
      "sura": "113",
      "aya": "3",
      "arabic_text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "translation": "Tegen het kwaad van de duisternis en wat zich daarin bevindt.",
      "footnotes": ""
    },
    {
      "id": "6229",
      "sura": "113",
      "aya": "4",
      "arabic_text": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ",
      "translation": "Tegen het kwaad van degenen die op knopen blazen (de magiërs).",
      "footnotes": ""
    },
    {
      "id": "6230",
      "sura": "113",
      "aya": "5",
      "arabic_text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "translation": "En tegen het boze (oog) van de jaloerse wanneer hij benijdt.”",
      "footnotes": ""
    }
  ],
