  "data": [
    {
      "id": "6194",
      "sura": "106",
      "aya": "1",
      "arabic_text": "لِإِيلَٰفِ قُرَيۡشٍ",
      "translation": "Zodat Qoeraysh gewend zouden raken.",
      "footnotes": ""
    },
    {
      "id": "6195",
      "sura": "106",
      "aya": "2",
      "arabic_text": "إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ",
      "translation": "Gewend zouden raken aan het reizen in de winter en de zomer.",
      "footnotes": ""
    },
    {
      "id": "6196",
      "sura": "106",
      "aya": "3",
      "arabic_text": "فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ",
      "translation": "Laten zij dus de Heer van het huis aanbidden en danken.",
      "footnotes": ""
    },
    {
      "id": "6197",
      "sura": "106",
      "aya": "4",
      "arabic_text": "ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ",
      "translation": "(Hij) Die hen in hongerige tijden voedt en hen veilig stelt tegen vrees.",
      "footnotes": ""
    }
  ],
