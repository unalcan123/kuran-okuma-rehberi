  "data": [
    {
      "id": "6222",
      "sura": "112",
      "aya": "1",
      "arabic_text": "قُلۡ هُوَ ٱللَّهُ أَحَدٌ",
      "translation": "1. Di: “Él es Al-lah[1], Uno.",
      "footnotes": "[1] Ver Corán 1:1 para la aclaración sobre el nombre de Dios."
    },
    {
      "id": "6223",
      "sura": "112",
      "aya": "2",
      "arabic_text": "ٱللَّهُ ٱلصَّمَدُ",
      "translation": "2. Al-lah es el Absoluto[1].",
      "footnotes": "[1] De Quien todos necesitan, mientras que Él no necesita de nadie."
    },
    {
      "id": "6224",
      "sura": "112",
      "aya": "3",
      "arabic_text": "لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ",
      "translation": "3. No engendró ni fue engendrado.",
      "footnotes": ""
    },
    {
      "id": "6225",
      "sura": "112",
      "aya": "4",
      "arabic_text": "وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ",
      "translation": "4. Y no hay nada ni nadie que sea semejante a Él”.",
      "footnotes": ""
    }
  ],
