{
  "93:1": {
    "text": "وَالضُّحٰىۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-1/diyanet-vakfi-meali-4"
  },
  "93:2": {
    "text": "وَالَّيْلِ اِذَا سَجٰىۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-1/diyanet-vakfi-meali-4"
  },
  "93:3": {
    "text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-1/diyanet-vakfi-meali-4"
  },
  "94:1": {
    "text": "اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "94:2": {
    "text": "وَوَضَعْنَا عَنْكَ وِزْرَكَۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "94:3": {
    "text": "اَلَّـذٖٓي اَنْقَضَ ظَهْرَكَۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "94:4": {
    "text": "وَرَفَعْنَا لَكَ ذِكْرَكَؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "94:5": {
    "text": "فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "94:6": {
    "text": "اِنَّ مَعَ الْعُسْرِ يُسْرًاۜ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "94:7": {
    "text": "فَاِذَا فَرَغْتَ فَانْصَبْۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "94:8": {
    "text": "وَاِلٰى رَبِّكَ فَارْغَبْ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "93:4": {
    "text": "وَلَلْاٰخِرَةُ خَيْرٌ لَكَ مِنَ الْاُو۫لٰىؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "93:5": {
    "text": "وَلَسَوْفَ يُعْطٖيكَ رَبُّكَ فَتَـرْضٰىؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "93:6": {
    "text": "اَلَمْ يَجِدْكَ يَتٖيمًا فَاٰوٰىۖ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "93:7": {
    "text": "وَوَجَدَكَ ضَٓالًّا فَهَدٰىۖ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "93:8": {
    "text": "وَوَجَدَكَ عَٓائِلًا فَاَغْنٰىۜ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "93:9": {
    "text": "فَاَمَّا الْيَتٖيمَ فَلَا تَقْهَرْؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "93:10": {
    "text": "وَاَمَّا السَّٓائِلَ فَلَا تَنْهَرْؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "93:11": {
    "text": "وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "95:1": {
    "text": "وَالتّٖينِ وَالزَّيْتُونِۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "95:2": {
    "text": "وَطُورِ سٖينٖينَۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "95:3": {
    "text": "وَهٰذَا الْبَلَدِ الْاَمٖينِۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "95:4": {
    "text": "لَقَدْ خَلَقْنَا الْاِنْسَانَ فٖٓي اَحْسَنِ تَقْوٖيمٍؗ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/duha-suresi-93/ayet-4/kuran-yolu-meali-5"
  },
  "95:5": {
    "text": "ثُمَّ رَدَدْنَاهُ اَسْفَلَ سَافِلٖينَۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-2/insirah-suresi-94/ayet-1/kuran-yolu-meali-5"
  },
  "94:10": {
    "text": "وَاَمَّا السَّٓائِلَ فَلَا تَنْهَرْؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/insirah-suresi-94/ayet-1/kuran-yolu-meali-5"
  },
  "94:11": {
    "text": "وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/insirah-suresi-94/ayet-1/kuran-yolu-meali-5"
  },
  "97:1": {
    "text": "اِنَّٓا اَنْزَلْنَاهُ فٖي لَيْلَةِ الْقَدْرِۚ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/kadir-suresi-97/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "97:2": {
    "text": "وَمَٓا اَدْرٰيكَ مَا لَيْلَةُ الْقَدْرِؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/kadir-suresi-97/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "97:3": {
    "text": "لَيْلَةُ الْقَدْرِ خَيْرٌ مِنْ اَلْفِ شَهْرٍؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/kadir-suresi-97/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "97:4": {
    "text": "تَنَزَّلُ الْمَلٰٓئِكَةُ وَالرُّوحُ فٖيهَا بِاِذْنِ رَبِّهِمْۚ مِنْ كُلِّ اَمْرٍۙۛ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/kadir-suresi-97/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "97:5": {
    "text": "سَلَامٌࣞۛ هِيَ حَتّٰى مَطْلَعِ الْفَجْرِ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/kadir-suresi-97/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "99:1": {
    "text": "اِذَا زُلْزِلَتِ الْاَرْضُ زِلْزَالَهَاۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "99:2": {
    "text": "وَاَخْرَجَتِ الْاَرْضُ اَثْقَالَهَاۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "99:3": {
    "text": "وَقَالَ الْاِنْسَانُ مَا لَهَاۚ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "99:4": {
    "text": "يَوْمَئِذٍ تُحَدِّثُ اَخْبَارَهَاۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "99:5": {
    "text": "بِاَنَّ رَبَّكَ اَوْحٰى لَهَاؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "99:6": {
    "text": "يَوْمَئِذٍ يَصْدُرُ النَّاسُ اَشْتَاتًا لِيُرَوْا اَعْمَالَهُمْۜ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "99:7": {
    "text": "فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۜ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "99:8": {
    "text": "وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "99:9": {
    "text": "اَفَلَا يَعْلَمُ اِذَا بُعْثِرَ مَا فِي الْقُبُورِۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/Zilz%C3%A2l-S%C3%BBresi-99/ayet-1/diyanet-vakfi-meali-4"
  },
  "99:10": {
    "text": "وَحُصِّلَ مَا فِي الصُّدُورِۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/Zilz%C3%A2l-S%C3%BBresi-99/ayet-1/diyanet-vakfi-meali-4"
  },
  "99:11": {
    "text": "اِنَّ رَبَّهُمْ بِهِمْ يَوْمَئِذٍ لَخَبٖيرٌ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/Zilz%C3%A2l-S%C3%BBresi-99/ayet-1/diyanet-vakfi-meali-4"
  },
  "100:1": {
    "text": "وَالْعَادِيَاتِ ضَبْحًاۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "100:2": {
    "text": "فَالْمُورِيَاتِ قَدْحًاۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "100:3": {
    "text": "فَالْمُغٖيرَاتِ صُبْحًاۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "100:4": {
    "text": "فَاَثَرْنَ بِهٖ نَقْعًاۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "100:5": {
    "text": "فَوَسَطْنَ بِهٖ جَمْعًاۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "100:6": {
    "text": "اِنَّ الْاِنْسَانَ لِرَبِّهٖ لَكَنُودٌۚ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "100:7": {
    "text": "وَاِنَّهُ عَلٰى ذٰلِكَ لَشَهٖيدٌۚ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "100:8": {
    "text": "وَاِنَّهُ لِحُبِّ الْخَيْرِ لَشَدٖيدٌؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "100:9": {
    "text": "اَفَلَا يَعْلَمُ اِذَا بُعْثِرَ مَا فِي الْقُبُورِۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "100:10": {
    "text": "وَحُصِّلَ مَا فِي الصُّدُورِۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "100:11": {
    "text": "اِنَّ رَبَّهُمْ بِهِمْ يَوْمَئِذٍ لَخَبٖيرٌ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/adiyat-suresi-100/ayet-1/kuran-yolu-meali-5"
  },
  "103:1": {
    "text": "وَالْعَصْرِۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "103:2": {
    "text": "اِنَّ الْاِنْسَانَ لَفٖي خُسْرٍۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "103:3": {
    "text": "اِلَّا الَّذٖينَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "104:1": {
    "text": "وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "104:2": {
    "text": "اَلَّذٖى جَمَعَ مَالًا وَعَدَّدَهُۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "104:3": {
    "text": "يَحْسَبُ اَنَّ مَالَـهُٓ اَخْلَدَهُۚ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "104:4": {
    "text": "كَلَّا لَيُنْبَذَنَّ فِي الْحُطَمَةِؗ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "104:5": {
    "text": "وَمَٓا اَدْرٰيكَ مَا الْحُطَمَةُؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "104:6": {
    "text": "نَارُ اللّٰهِ الْمُوقَدَةُۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "104:7": {
    "text": "اَلَّتٖي تَطَّلِعُ عَلَى الْاَفْـِٔدَةِؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "104:8": {
    "text": "اِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "104:9": {
    "text": "فٖي عَمَدٍ مُمَدَّدَةٍ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/humeze-suresi-104/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "101:1": {
    "text": "اَلْقَارِعَةُۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "101:2": {
    "text": "مَا الْقَارِعَةُۚ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "101:3": {
    "text": "وَمَٓا اَدْرٰيكَ مَا الْقَارِعَةُۜ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "101:4": {
    "text": "يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "101:5": {
    "text": "وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِۜ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "101:6": {
    "text": "فَاَمَّا مَنْ ثَقُلَتْ مَوَازٖينُهُۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "101:7": {
    "text": "فَهُوَ فٖي عٖيشَةٍ رَاضِيَةٍؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "101:8": {
    "text": "وَاَمَّا مَنْ خَفَّتْ مَوَازٖينُهُۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "101:9": {
    "text": "فَاُمُّهُ هَاوِيَةٌؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "101:10": {
    "text": "وَمَٓا اَدْرٰيكَ مَا هِيَهْؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "101:11": {
    "text": "نَارٌ حَامِيَةٌ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "102:1": {
    "text": "اَلْهٰيكُمُ التَّكَاثُرُۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "102:2": {
    "text": "حَتّٰى زُرْتُمُ الْمَقَابِرَؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "102:3": {
    "text": "كَلَّا سَوْفَ تَعْلَمُونَۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "102:4": {
    "text": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "102:5": {
    "text": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَقٖينِؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "102:6": {
    "text": "لَتَرَوُنَّ الْجَحٖيمَۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "102:7": {
    "text": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقٖينِۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "102:8": {
    "text": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ النَّعٖيمِ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/tekasur-suresi-102/ayet-1/diyanet-isleri-baskanligi-meali-1"
  },
  "95:6": {
    "text": "اِلَّا الَّذٖينَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ اَجْرٌ غَيْرُ مَمْنُونٍؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/tin-suresi-95/ayet-6/diyanet-isleri-baskanligi-meali-1"
  },
  "95:7": {
    "text": "فَمَا يُكَذِّبُكَ بَعْدُ بِالدّٖينِؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/tin-suresi-95/ayet-6/diyanet-isleri-baskanligi-meali-1"
  },
  "95:8": {
    "text": "اَلَيْسَ اللّٰهُ بِاَحْكَمِ الْحَاكِمٖينَ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/tin-suresi-95/ayet-6/diyanet-isleri-baskanligi-meali-1"
  },
  "95:9": {
    "text": "اَرَاَيْتَ الَّذٖي يَنْهٰىۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-tefsir-1/T%C3%AEn-S%C3%BBresi-95/ayet-6/diyanet-isleri-baskanligi-meali-1"
  },
  "95:10": {
    "text": "عَبْدًا اِذَا صَلّٰىۜ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-tefsir-1/T%C3%AEn-S%C3%BBresi-95/ayet-6/diyanet-isleri-baskanligi-meali-1"
  },
  "95:11": {
    "text": "اَرَاَيْتَ اِنْ كَانَ عَلَى الْهُدٰىۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-tefsir-1/T%C3%AEn-S%C3%BBresi-95/ayet-6/diyanet-isleri-baskanligi-meali-1"
  },
  "95:12": {
    "text": "اَوْ اَمَرَ بِالتَّقْوٰىؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-tefsir-1/T%C3%AEn-S%C3%BBresi-95/ayet-6/diyanet-isleri-baskanligi-meali-1"
  },
  "95:13": {
    "text": "اَرَاَيْتَ اِنْ كَذَّبَ وَتَوَلّٰىؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-tefsir-1/T%C3%AEn-S%C3%BBresi-95/ayet-6/diyanet-isleri-baskanligi-meali-1"
  },
  "95:14": {
    "text": "اَلَمْ يَعْلَمْ بِاَنَّ اللّٰهَ يَرٰىؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-tefsir-1/T%C3%AEn-S%C3%BBresi-95/ayet-6/diyanet-isleri-baskanligi-meali-1"
  },
  "78:31": {
    "text": "اِنَّ لِلْمُتَّقٖينَ مَفَازاًۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:32": {
    "text": "حَدَٓائِقَ وَاَعْنَاباًۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:33": {
    "text": "وَكَوَاعِبَ اَتْرَاباًۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:34": {
    "text": "وَكَأْساً دِهَاقاًؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:35": {
    "text": "لَا يَسْمَعُونَ فٖيهَا لَغْواً وَلَا كِذَّاباًۚ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:36": {
    "text": "جَزَٓاءً مِنْ رَبِّكَ عَطَٓاءً حِسَاباًۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:37": {
    "text": "رَبِّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَيْنَهُمَاۙ الرَّحْمٰنِ لَا يَمْلِكُونَ مِنْهُ خِطَاباًۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:38": {
    "text": "يَوْمَ يَقُومُ الرُّوحُ وَالْمَلٰٓئِكَةُ صَفاًّؕ لَا يَتَكَلَّمُونَ اِلَّا مَنْ اَذِنَ لَهُ الرَّحْمٰنُ وَقَالَ صَوَاباً",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:2": {
    "text": "وَالنَّاشِطَاتِ نَشْطاًۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:3": {
    "text": "وَالسَّابِحَاتِ سَبْحاًۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:4": {
    "text": "فَالسَّابِقَاتِ سَبْقاًۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:5": {
    "text": "فَالْمُدَبِّرَاتِ اَمْراًۘ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:6": {
    "text": "يَوْمَ تَرْجُفُ الرَّاجِفَةُۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:7": {
    "text": "تَتْبَعُهَا الرَّادِفَةُؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:8": {
    "text": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:9": {
    "text": "اَبْصَارُهَا خَاشِعَةٌۘ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:10": {
    "text": "يَقُولُونَ ءَاِنَّا لَمَرْدُودُونَ فِي الْحَافِرَةِؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:11": {
    "text": "ءَاِذَا كُنَّا عِظَاماً نَخِرَةًؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:12": {
    "text": "قَالُوا تِلْكَ اِذاً كَرَّةٌ خَاسِرَةٌۘ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:13": {
    "text": "فَاِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:14": {
    "text": "فَاِذَا هُمْ بِالسَّاهِرَةِؕ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-meal-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:1": {
    "text": "وَالنَّازِعَاتِ غَرْقاًۙ",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-tefsir-1/Nebe-S%C3%BBresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:39": {
    "text": "ذٰلِكَ الْيَوْمُ الْحَقُّۚ فَمَنْ شَٓاءَ اتَّخَذَ اِلٰى رَبِّهٖ مَاٰباً",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  },
  "78:40": {
    "text": "اِنَّٓا اَنْذَرْنَاكُمْ عَذَاباً قَرٖيباًۚ يَوْمَ يَنْظُرُ الْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ الْكَافِرُ يَا لَيْتَنٖي كُنْتُ تُرَاباً",
    "source": "https://kuran.diyanet.gov.tr/mushaf/kuran-1/nebe-suresi-78/ayet-31/kuran-yolu-meali-5"
  }
}